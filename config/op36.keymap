#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define HRM_IDLE 120
#define HRM_TAP_TERM 170
#define HRM_QUICK_TAP 150
#define FLAVOR "balanced"

&mt {
    quick-tap-ms = <200>;
    flavor = "tap-preferred";
    require-prior-idle-ms = <125>;
};

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = FLAVOR;
            require-prior-idle-ms = <HRM_IDLE>;
            tapping-term-ms = <HRM_TAP_TERM>;
            quick-tap-ms = <HRM_QUICK_TAP>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 33 34 35>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = FLAVOR;
            require-prior-idle-ms = <HRM_IDLE>;
            tapping-term-ms = <HRM_TAP_TERM>;
            quick-tap-ms = <HRM_QUICK_TAP>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32>;
            hold-trigger-on-release;
        };
    };

    combos {
        compatible = "zmk,combos";

        kha {
            bindings = <&kp LBKT>;
            key-positions = <6 7>;
        };

        hrdsgn {
            bindings = <&kp RBKT>;
            key-positions = <7 8>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
  &kp Q         &kp W        &kp E  &kp R         &kp T                              &kp Y  &kp U  &kp I      &kp O    &kp P
  &hml LGUI A   &hml LALT S  &kp D  &hml LCTRL F  &kp G                              &kp H  &kp J  &kp K      &kp L    &hmr RGUI SEMICOLON
  &hml LSHFT Z  &kp X        &kp C  &kp V         &kp B                              &kp N  &kp M  &kp COMMA  &kp DOT  &hmr RSHFT FSLH
                                    &kp TAB       &mo 1  &kp BACKSPACE    &kp SPACE  &mo 2  &kp LCTRL
            >;

            display-name = "Base-layer";
        };

        left {
            bindings = <
  &kp EXCL    &kp AT     &kp HASH  &kp DLLR  &kp PRCNT                     &kp CARET &kp AMPS  &kp STAR   &kp LPAR   &kp RPAR
  &kp ESC     &kp PLUS   &kp LBRC  &kp RBRC  &kp RET                       &kp LEFT  &kp DOWN  &kp UP     &kp RIGHT  &none
  &kp LSHIFT  &kp UNDER  &kp LPAR  &kp RPAR  &kp SQT                       &none     &none     &kp PG_DN  &kp PG_UP  &kp RSHFT
                                   &trans    &trans      &trans    &trans  &mo 3     &trans
            >;

            display-name = "Left-layer";
        };

        right {
            bindings = <
  &kp N1             &kp N2     &kp N3    &kp N4    &kp N5                      &kp N6     &kp N7     &kp N8     &kp N9    &kp N0
  &kp MINUS          &kp EQUAL  &kp LBKT  &kp RBKT  &kp BSLH                    &kp PIPE   &kp LBRC   &kp AMPS   &kp RBRC  &none
  &hml LSHIFT TILDE  &kp STAR   &kp LPAR  &kp RPAR  &kp DQT                     &kp GRAVE  &kp PRCNT  &none      &none     &hml RSHFT DLLR
                                          &trans    &mo 3     &trans    &trans  &trans     &trans
            >;

            display-name = "Right-layer";
        };

        adj {
            bindings = <
  &bootloader  &kp F1        &kp F2         &kp F3         &kp F4                     &bt BT_SEL 0  &bt BT_SEL 1         &bt BT_SEL 2       &bt BT_SEL 3        &bt BT_CLR
  &kp CAPS     &hml LALT F5  &hml LSHFT F6  &hml LCTRL F7  &kp F8                     &out OUT_BLE  &hmr RCTRL C_VOL_DN  &hmr RSHFT C_MUTE  &hmr LALT C_VOL_UP  &kp RGUI
  &none        &kp F9        &kp F10        &kp F11        &kp F12                    &out OUT_USB  &kp C_PREV           &kp C_PP           &kp C_NEXT          &studio_unlock
                                            &trans         &trans   &trans    &trans  &trans        &trans
            >;

            display-name = "Adjust-layer";
        };
    };
};
